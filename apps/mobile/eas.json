{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development",
        "APP_LANG": "both"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "preview",
        "APP_LANG": "both"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview-en": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "preview",
        "APP_LANG": "en"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview-ja": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "preview",
        "APP_LANG": "ja"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "ios-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "APP_LANG": "both"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-en": {
      "extends": "production",
      "env": {
        "APP_VARIANT": "production",
        "APP_LANG": "en"
      }
    },
    "production-ja": {
      "extends": "production",
      "env": {
        "APP_VARIANT": "production",
        "APP_LANG": "ja"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
